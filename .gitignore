.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
dist/
build/
*.egg-info/

# Local config — public repo: real EDGAR contact email must never be committed.
# Copy fintin.toml.example -> fintin.toml and edit locally.
fintin.toml

# Config backups written by `fintin universe --refresh-sp500 --write`. These are
# copies of fintin.toml and therefore contain the real contact email — same
# secret, so the same rule applies.
fintin.toml.bak
*.toml.bak

# Single-flight lease file (runtime state; the default [lease].path). If you set a
# custom lease path in fintin.toml, that file is runtime state too — ignore it.
fintin.lease

# macOS
.DS_Store

# BMAD agent memory logs (per-run churn)
_bmad-output/**/.memlog.md

