# fin-tin configuration TEMPLATE.
#
# Copy this to `fintin.toml` and fill in your values:
#
#     cp fintin.toml.example fintin.toml
#
# `fintin.toml` is gitignored — this repo is public, so your real EDGAR contact
# email must never be committed. Edit only your local copy.

[clickhouse]
host = "localhost"
port = 8123
username = "default"
password = "fintin_local"   # matches CLICKHOUSE_PASSWORD in docker-compose.yml (local-only)
database = "default"

[edgar]
# EDGAR fair-access compliance (BAN-CRITICAL). EDGAR requires a declared,
# identifying User-Agent with REAL contact info; a blank/placeholder UA is
# rejected as an "Undeclared Automated Tool". Set contact_email to YOUR real
# address in your local fintin.toml before running against EDGAR — the EDGAR
# client rejects the placeholder below at startup, so the tool fails loudly
# rather than send a bad User-Agent.
user_agent_name  = "fin-tin"
contact_email    = "you@example.com"   # <-- REPLACE with your real email in fintin.toml
rate_limit_per_sec = 9                 # SEC max is 10; 9 leaves a safety margin (1 <= x <= 10)
cooldown_seconds   = 600               # >= 600 (SEC 10-minute cool-down on a throttle breach)
max_throttle_retries = 3               # cool-down + retry attempts before failing loudly

[universe]
# The screening Universe: a static list of tickers and/or CIKs (FR-7, AD-13).
# Tickers and CIKs are PUBLIC data (safe to commit here) — unlike contact_email.
#
# The sample below is a handful of large caps so a fresh checkout works out of the
# box. For the FULL S&P 500 (503 listings, dual share classes included), fetch the
# current constituents and rewrite this section:
#
#     fintin universe --refresh-sp500            # print the block, paste it yourself
#     fintin universe --refresh-sp500 --write    # rewrite this section (backs up first)
#
# That is one non-EDGAR HTTP GET (the SEC doesn't publish index membership), so it
# needs no contact email and spends no EDGAR request budget. Symbols the bundled
# reference table can't resolve are carried into `ciks` from the source's own CIK
# column, so the Universe stays complete instead of accruing gaps.
#
# Tickers resolve to CIKs OFFLINE via edgartools' bundled reference table (no
# EDGAR request, no email needed) — run `fintin universe` to resolve & report
# scope. A ticker not in the bundled table is reported as an explained gap
# (never silently dropped); resolve it by adding its numeric `cik` directly.
# Grow the Universe by editing this list alone — no code or schema change (NFR-2).
tickers = [
    "AAPL", "MSFT", "AMZN", "GOOGL", "META", "NVDA", "BRK.B", "JPM",
    "JNJ", "V", "PG", "XOM", "WMT", "KO", "DIS",
]
ciks = [
    1652044,   # Alphabet — example of a direct CIK entry (skips ticker resolution)
]
# Where --refresh-sp500 fetches from. Optional — omit to use the pinned default
# (a public CSV of S&P 500 members carrying both Symbol and CIK columns). Override
# it to track a different index, or to pin your own copy if the source moves.
# constituents_url = "https://raw.githubusercontent.com/datasets/s-and-p-500-companies/main/data/constituents.csv"

[reconcile]
# Work-list tuning (optional; omit to use the default). lookback_days sizes the
# reordering-safe scan window [high-water-mark - lookback, today] that
# `fintin work-list` (and, later, catch-up) re-scans EDGAR's index over — wide
# enough to catch stragglers/restatements filed just before the high-water mark.
lookback_days = 7

[lease]
# Single-flight self-expiring lease (optional; omit to use the defaults below).
# At most one ingestion run (backfill / catch-up) touches EDGAR at a time — a
# concurrent second trigger returns ALREADY_RUNNING (exit-0) and issues NO EDGAR
# request, so overlapping runs can't double the request rate (a ban). This is a
# local lock FILE (below), not ClickHouse; it self-expires so a crashed run never
# permanently deadlocks the tool. The lease file holds only {pid, host, timestamps}
# (no secrets) and is runtime state — gitignored.
path = "fintin.lease"      # lock-file path (relative to the working directory)
ttl_seconds = 120          # a lease is expired this long after its last heartbeat
heartbeat_seconds = 15     # a live run refreshes the lease this often (must be <= ttl/2)
